{
  "manifest_version": 3,
  "name": "SafeNET",
  "version": "1.1",
  "description": "Real-time browser protection with visual scanning.",
  "permissions": ["tabs", "activeTab", "storage", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}